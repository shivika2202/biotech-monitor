# Local environment
.venv/
__pycache__/
.pytest_cache/
.DS_Store

# Personal contact for the SEC User-Agent (see config/user_agent.example.txt)
config/user_agent.txt

# Private files dropped in by hand (may contain paywalled or personal material)
data/inbox/

# Raw downloads and run logs are regenerated by the scripts; only curated
# outputs (filing notes, catalyst and failure logs) are tracked.
data/*
!data/README.md
!data/catalysts.csv
!data/failures.csv
!data/filing_notes/
logs/
digests/
